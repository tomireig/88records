# ─── 88RECORDS® · variables de entorno ─────────────────────────────────────────
# Copiá este archivo a .env (en la raíz). Web y worker leen el mismo.
# Sin claves externas la app corre en modo local: Postgres embebido, archivos en disco
# y sin login (entra directo como el dueño). Nunca subas el .env a GitHub.

# URL pública del panel (para callbacks de OAuth y links firmados del storage local)
APP_URL=http://localhost:3000

# ─── Base de datos ──────────────────────────────────────────────────────────────
# Local: `pnpm db:local` levanta Postgres en el 5432 con estos datos.
# Vercel + Neon (Storage → Neon): la integración carga DATABASE_URL y DATABASE_URL_UNPOOLED sola.
# Supabase: DATABASE_URL = pooler en modo transacción (puerto 6543, ?pgbouncer=true)
#           DATABASE_URL_UNPOOLED = pooler en modo sesión (puerto 5432). Lo usan las migraciones y las colas.
# La plataforma usa el schema "plataforma" (DATABASE_SCHEMA para cambiarlo); si la URL no lo trae, se agrega solo.
DATABASE_URL=postgresql://records:records@localhost:5432/records?schema=plataforma
DATABASE_URL_UNPOOLED=postgresql://records:records@localhost:5432/records?schema=plataforma

# ─── Seguridad ──────────────────────────────────────────────────────────────────
# 32 bytes en base64. Generala con `pnpm keygen`. Si la cambiás, hay que reconectar las cuentas.
TOKEN_ENCRYPTION_KEY=

# ─── Login (Supabase Auth) ──────────────────────────────────────────────────────
# Sin esto, en desarrollo se entra sin login como LOCAL_USER_EMAIL. En producción es obligatorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mails que entran como dueños de 88RECORDS la primera vez que inician sesión (separados por coma).
OWNER_EMAILS=
LOCAL_USER_EMAIL=local@88records.dev
# Dueño que crea `pnpm db:seed`
SEED_OWNER_EMAIL=

# ─── Storage ────────────────────────────────────────────────────────────────────
# local: archivos en .storage/ (solo desarrollo). s3: Cloudflare R2 o cualquier S3.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── TikTok (developers.tiktok.com) ────────────────────────────────────────────
# Productos: Login Kit + Content Posting API. Redirect URI: {APP_URL}/api/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# false: los videos llegan como borrador a la app de TikTok (scope video.upload).
# true: publica directo (scope video.publish).
TIKTOK_DIRECT_POST_ENABLED=false
# Ponelo en true cuando TikTok apruebe la auditoría. Sin auditoría: todo sale privado y hasta 5 cuentas por día.
TIKTOK_APP_AUDITED=false

# ─── FFmpeg (opcional) ──────────────────────────────────────────────────────────
# Por defecto usa los binarios de ffmpeg-static. Solo si querés otro:
# FFMPEG_PATH=
# FFPROBE_PATH=
