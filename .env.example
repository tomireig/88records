# Base de datos (Postgres). Sirve igual con docker compose o con `pnpm db:local`.
# En Vercel, la integración de Neon carga estas dos solas.
DATABASE_URL="postgresql://records:records@localhost:5432/records"
DATABASE_URL_UNPOOLED="postgresql://records:records@localhost:5432/records"

# Login. Si APP_PASSWORD queda vacío en desarrollo, la app no pide contraseña.
# AUTH_SECRET: cualquier texto largo al azar (firma la cookie de sesión).
APP_PASSWORD=""
AUTH_SECRET=""

# IA Studio. Sin key, la app usa plantillas locales.
ANTHROPIC_API_KEY=""
# Opcional. Por defecto claude-opus-5-5.
AI_MODEL=""
