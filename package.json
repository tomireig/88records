{
  "name": "88records",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "pnpm --filter @88/db migrate",
    "db:deploy": "pnpm --filter @88/db run migrate:deploy",
    "db:seed": "pnpm --filter @88/db seed",
    "db:studio": "pnpm --filter @88/db studio"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
