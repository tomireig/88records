{
  "name": "88records",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "pnpm --filter @88/db migrate",
    "db:deploy": "pnpm --filter @88/db run migrate:deploy",
    "db:seed": "pnpm --filter @88/db seed",
    "db:studio": "pnpm --filter @88/db studio",
    "worker": "pnpm --filter @88/worker start",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
